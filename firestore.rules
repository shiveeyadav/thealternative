rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth.uid == 'he4x6yM1tVS6LZC9B2c7VlfyZog1'
          || request.auth.uid == 'DiaHTyY0mybaE8LkCruJtweXsQA2';
    }

    function isAuthorized(userId) {
      return request.auth != null && (userId == request.auth.uid || isAdmin());
    }

    function isValidText(text) {
      return (text is string && text.size() <= 560) || text == null;
    }

    function isValidImages(images) {
      return (images is list && images.size() <= 4) || images == null;
    }

    function onlyOwnIdChanged(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).hasOnly([request.auth.uid])
             && before.difference(after).hasOnly([request.auth.uid]);
    }

    function repliesMovedByOne() {
      let before = resource.data.get('userReplies', 0);
      let after = request.resource.data.get('userReplies', 0);
      return after is int && after >= 0
             && (after == before || after == before + 1 || after == before - 1);
    }

    // Fields any signed-in user may change on someone else's tweet: likes,
    // retweets and the reply counter. Everything else (text, images,
    // createdBy, ...) stays owner/admin only.
    // ...and only in the way the app itself does it: add or remove the caller's own
    // uid from userLikes / userRetweets, and move the reply counter by one. Without
    // this, any signed-in user could wipe or forge other people's likes and retweets.
    function onlySocialFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['userLikes', 'userRetweets', 'userReplies', 'updatedAt'])
             && onlyOwnIdChanged('userLikes')
             && onlyOwnIdChanged('userRetweets')
             && repliesMovedByOne();
    }

    match /tweets/{tweetId} {
      allow read: if request.auth != null;
      allow create: if isAuthorized(request.resource.data.createdBy)
                       && isValidText(request.resource.data.text)
                       && isValidImages(request.resource.data.images);
      allow update: if request.auth != null
                       && ((isAuthorized(resource.data.createdBy)
                             && isValidText(request.resource.data.text)
                             && isValidImages(request.resource.data.images))
                           || onlySocialFieldsChanged());
      allow delete: if isAuthorized(resource.data.createdBy);
    }

    // User profile — readable by any logged-in user, writable only by owner or admin
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if isAuthorized(userId);
      allow delete: if isAdmin();
    }

    // Notifications live under the recipient, but are written by whoever
    // triggered them, so other signed-in users need a narrow create path.
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isAuthorized(userId);

      allow create: if request.auth != null
                       && request.resource.data.fromUserId == request.auth.uid
                       && request.resource.data.fromUserId != userId
                       && request.resource.data.read == false
                       && request.resource.data.type in ['like', 'reply', 'follow'];

      // the actor can withdraw their own notification (unlike, unfollow)
      allow delete: if request.auth != null
                       && resource.data.fromUserId == request.auth.uid;
    }

    // User sub-collections (bookmarks, stats) — only owner or admin
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if isAuthorized(userId);
    }
  }
}
